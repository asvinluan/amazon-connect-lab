# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
tfplan
plan.txt

# Never commit real values: these hold account ids, instance ids, phone numbers
*.tfvars
!*.tfvars.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
*.zip

# Editors / OS
.vscode/
.idea/
.DS_Store

# Node (ServiceNow Lambda). node_modules is installed from package-lock.json,
# dist is rebuilt by npm run build. Neither is ever committed.
node_modules/
dist/

# Backups made by scripts/servicenow/install-workflows
*.bak

tfplan-ai
